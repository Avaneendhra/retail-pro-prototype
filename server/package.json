{
  "name": "stokd-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "stokd API: accounts and multi-device sync",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/node.js",
    "test": "node --test \"test/*.test.js\"",
    "dev": "wrangler dev",
    "migrate": "wrangler d1 migrations apply stokd --remote",
    "deploy": "wrangler d1 migrations apply stokd --remote && wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "wrangler": "^4.163.0"
  }
}
