# Copy to .env only if you need to change something. Everything works without it.

# --- Building the app for GitHub Pages while the API lives elsewhere ---
# Address of your stokd server (no trailing slash). Leave unset when the app and API share one address.
# VITE_API_URL=https://stokd.your-name.workers.dev

# --- Running the server with Node (npm start) ---
# PORT=8787
# DATABASE_PATH=server/data/stokd.db
# JWT_SECRET=           # made automatically on first run if unset; at least 32 characters
# ALLOWED_ORIGINS=https://avaneendhra.github.io    # other sites allowed to call this API, comma separated
# SIGNUP_CODE=          # if set, new shops need this code to sign up
