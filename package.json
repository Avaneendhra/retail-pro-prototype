    "react-i18next": "^16.2.4",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^6.21.3",
    "recharts": "^3.3.0",
    "tesseract.js": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
